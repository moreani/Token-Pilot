# TokenPilot Configuration Template
# Copy this file to .env and configure as needed.
# Note: Sensitive secrets are never committed to version control.

# Server Configuration
PORT=5173
HOST=127.0.0.1
NODE_ENV=development

# Quota Collection Settings
TOKENPILOT_STRICT_MODE=true
TOKENPILOT_FRESHNESS_THRESHOLD_HOURS=24

# Sandbox Settings
SANDBOX_PROVIDER=mock
DOCKER_HOST=
