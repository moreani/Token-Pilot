{
  "name": "tokenpilot",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first command center for AI subscriptions and safe manual R&D execution",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:ts": "node --loader ts-node/esm --test tests/**/*.test.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/desktop",
    "graphify": "graphify extract . --code-only && graphify cluster-only .",
    "graphify:update": "graphify update .",
    "graphify:query": "graphify query"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tokscale": "^4.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
